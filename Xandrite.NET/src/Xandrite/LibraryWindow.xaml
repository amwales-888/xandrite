<Window x:Class="Xandrite.App.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Xandrite.App"
        xmlns:vm="clr-namespace:Xandrite.Presentation;assembly=Xandrite.Presentation"
        Title="Xandrite"
        Width="1180" Height="820" MinWidth="640" MinHeight="480"
        Icon="Xandrite.ico"
        Background="#ECEFF2"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <local:BoolToVisibility x:Key="Visible" />
        <local:EmptyToCollapsed x:Key="IfText" />

        <SolidColorBrush x:Key="Accent" Color="#2F7DE1" />
        <SolidColorBrush x:Key="AccentDark" Color="#1A4A91" />
        <SolidColorBrush x:Key="AccentPale" Color="#EAF1FC" />
        <local:InverseBool x:Key="Not" />

        <!-- Small caps headings in the Filters panel and above the folders -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#5A6B78" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- A rounded button with a light border (the selection bar's actions) -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#A9B4BE" />
            <Setter Property="Foreground" Value="#1F2A33" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#F1F5FA" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- An active filter: its label and a cross; clicking it turns that filter off -->
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="BorderBrush" Value="#C3D3EA" />
            <Setter Property="Padding" Value="11,0,9,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#F1F5FA" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text that acts as a button ("Clear all", "Select all 214") -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#245FB8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A borderless button holding an icon (the order arrow) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="#F6F8F9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0,5,5,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#E3EAF2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The Filters button: pale blue while filters are on, solid blue while its panel is open -->
        <Style x:Key="FiltersToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#1F2A33" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Box" Background="White" BorderBrush="#A9B4BE" BorderThickness="1" CornerRadius="6" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasActiveFilters}" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentPale}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentDark}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentDark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rating choices in the Filters panel: a wrap of pills, the chosen one blue -->
        <Style x:Key="ChoiceList" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Pill" Background="White" BorderBrush="#C9D1D8" BorderThickness="1" CornerRadius="14"
                                            Padding="11,4" Margin="0,0,6,6">
                                        <TextBlock x:Name="Label" Text="{Binding Label}" Foreground="#1F2A33" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentPale}" />
                                            <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentDark}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource AccentDark}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modified / Added: two halves of one control -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Half" Background="White" Padding="12,0" Height="28" CornerRadius="5">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="#1F2A33" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Half" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Label" Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="SelectedTile" Color="#E3EEFC" />

        <!-- One thumbnail. Sizes come from the window's view model, so the slider resizes every tile. -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type vm:TileViewModel}">
            <Border x:Name="Tile"
                    Width="{Binding DataContext.TileSize, RelativeSource={RelativeSource AncestorType=Window}}"
                    Margin="0,0,8,0" Padding="6" CornerRadius="6"
                    Background="White" BorderBrush="Transparent" BorderThickness="2"
                    ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="700"
                    MouseLeftButtonDown="OnTileMouseDown" MouseRightButtonUp="OnTileRightClick">
                <StackPanel>
                    <Grid Height="{Binding DataContext.ImageSize, RelativeSource={RelativeSource AncestorType=Window}}" Background="#DFE5EA">
                        <TextBlock Text="{Binding PlaceholderText}" Foreground="#7A8A96" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="6" />
                        <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               local:ThumbnailImage.Tile="{Binding}"
                               local:ThumbnailImage.Version="{Binding ImageVersion}"
                               local:ThumbnailImage.DecodeSize="{Binding DataContext.ImageSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock Text="{Binding RatingText}" Foreground="#D99A00" FontSize="14"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5,0,0,3" />
                        <Border Background="#CC2F7DE1" CornerRadius="3" Padding="4,1" Margin="4"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Visibility="{Binding HasCustomView, Converter={StaticResource Visible}}">
                            <TextBlock Text="custom view" Foreground="White" FontSize="10" />
                        </Border>
                        <Border Background="#CCB3261E" CornerRadius="3" Padding="4,1" Margin="4"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Visibility="{Binding IsMissing, Converter={StaticResource Visible}}">
                            <TextBlock Text="missing" Foreground="White" FontSize="10" />
                        </Border>
                        <!-- The round tick: adds or removes this tile from the selection, like Ctrl-click. -->
                        <Border x:Name="Tick" Width="22" Height="22" CornerRadius="11" Margin="4"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="#B3FFFFFF" BorderBrush="#8094A3" BorderThickness="1.5"
                                Cursor="Hand" MouseLeftButtonDown="OnTickMouseDown">
                            <TextBlock x:Name="TickMark" Text="✓" Foreground="White" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Name}" Margin="0,5,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Caption}" Foreground="#6B7A86" FontSize="11"
                               Visibility="{Binding Caption, Converter={StaticResource IfText}}" />
                    <TextBlock Foreground="#6B7A86" FontSize="11" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ArchiveName, Converter={StaticResource IfText}}">
                        <Run Text="in " /><Run Text="{Binding ArchiveName, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource SelectedTile}" />
                    <Setter TargetName="Tick" Property="Background" Value="{StaticResource Accent}" />
                    <Setter TargetName="Tick" Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter TargetName="TickMark" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="Tile" Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ===== Toolbar: search, filters, order, size, preferences ===== -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D5DBE0" BorderThickness="0,0,0,1" Padding="14,9">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Xandrite" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />

                <!-- Search, with its hint inside the box -->
                <Border Width="380" Height="32" BorderBrush="#A9B4BE" BorderThickness="1" CornerRadius="6" Background="White" Padding="9,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#5A6B78"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Grid>
                            <TextBlock Text="Search names, folders or SHA-256" Foreground="#6B7884" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource IfText}, ConverterParameter=Invert}" />
                            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Search names, folders or SHA-256" />
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Filters: a button with the number that are on; the panel drops from it -->
                <ToggleButton x:Name="FiltersButton" Style="{StaticResource FiltersToggle}" Margin="10,0,0,0"
                              IsHitTestVisible="{Binding IsOpen, ElementName=FiltersPopup, Converter={StaticResource Not}}"
                              AutomationProperties.Name="Filters">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="Filters" VerticalAlignment="Center" />
                        <Border x:Name="FilterCount" Background="{StaticResource Accent}" CornerRadius="9" Padding="7,0" Margin="7,0,0,0" MinWidth="18"
                                Visibility="{Binding HasActiveFilters, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding ActiveFilterCount}" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </ToggleButton>
                <Popup x:Name="FiltersPopup" PlacementTarget="{Binding ElementName=FiltersButton}" Placement="Bottom" VerticalOffset="6"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                       IsOpen="{Binding IsChecked, ElementName=FiltersButton, Mode=TwoWay}">
                    <Border Width="340" Background="White" BorderBrush="#C9D1D8" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#1F2A33" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="RATING" Style="{StaticResource SectionLabel}" />
                            <ListBox ItemsSource="{Binding RatingOptions}" SelectedItem="{Binding RatingFilter}" Style="{StaticResource ChoiceList}"
                                     AutomationProperties.Name="Rating" />

                            <TextBlock Text="VIEWS" Style="{StaticResource SectionLabel}" Margin="0,14,0,8"
                                       ToolTip="Custom: thumbnails drawn from a view you saved in the viewer. Default: the automatic view." />
                            <ListBox ItemsSource="{Binding ViewOptions}" SelectedItem="{Binding ViewFilter}" Style="{StaticResource ChoiceList}"
                                     AutomationProperties.Name="Views" />

                            <TextBlock Text="COPIES" Style="{StaticResource SectionLabel}" Margin="0,14,0,8"
                                       ToolTip="Models found in more than one place. Each model's copies are listed together, the biggest first." />
                            <ListBox ItemsSource="{Binding CopiesOptions}" SelectedItem="{Binding CopiesFilter}" Style="{StaticResource ChoiceList}"
                                     AutomationProperties.Name="Copies" />

                            <TextBlock Text="DATE" Style="{StaticResource SectionLabel}" Margin="0,14,0,8" />
                            <DockPanel>
                                <Border DockPanel.Dock="Left" BorderBrush="#A9B4BE" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Modified" IsChecked="{Binding AgeByModified}" Style="{StaticResource Segment}" GroupName="AgeBasis" />
                                        <RadioButton Content="Added" IsChecked="{Binding AgeByAdded}" Style="{StaticResource Segment}" GroupName="AgeBasis" />
                                    </StackPanel>
                                </Border>
                                <ComboBox ItemsSource="{Binding AgeOptions}" SelectedItem="{Binding AgeFilter}" DisplayMemberPath="Label" Height="30"
                                          VerticalContentAlignment="Center" AutomationProperties.Name="When" />
                            </DockPanel>

                            <TextBlock Text="FILE SIZE" Style="{StaticResource SectionLabel}" Margin="0,14,0,8" />
                            <ComboBox ItemsSource="{Binding SizeOptions}" SelectedItem="{Binding SizeFilter}" DisplayMemberPath="Label" Height="30"
                                      VerticalContentAlignment="Center" AutomationProperties.Name="File size" />

                            <CheckBox Content="Show missing files" IsChecked="{Binding ShowMissing}" Margin="0,14,0,0" />

                            <Border BorderBrush="#E3E8EC" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,10,0,0">
                                <DockPanel>
                                    <Button Content="Clear all" Style="{StaticResource LinkButton}" Command="{Binding ClearAllFiltersCommand}" />
                                    <TextBlock Text="{Binding MatchText}" Foreground="#5A6B78" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Order: what to sort by, and which way -->
                <Border Height="32" BorderBrush="#A9B4BE" BorderThickness="1" CornerRadius="6" Margin="10,0,0,0" Background="White">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Sort" Foreground="#5A6B78" VerticalAlignment="Center" Margin="10,0,6,0" />
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}" DisplayMemberPath="Label" Width="130"
                                  BorderThickness="0" Background="White" VerticalContentAlignment="Center" Margin="0,3"
                                  AutomationProperties.Name="Sort by" />
                        <Button Command="{Binding ToggleDirectionCommand}" ToolTip="{Binding DirectionToolTip}" Style="{StaticResource IconButton}"
                                BorderBrush="#D5DBE0" BorderThickness="1,0,0,0" Width="34"
                                AutomationProperties.Name="{Binding DirectionToolTip}">
                            <TextBlock x:Name="DirectionArrow" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#3A4A56">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE74B;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAscending}" Value="True">
                                                <Setter Property="Text" Value="&#xE74A;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Thumbnail size -->
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" ToolTip="Thumbnail size">
                    <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#5A6B78" VerticalAlignment="Center" />
                    <Slider Width="96" VerticalAlignment="Center" Margin="6,0"
                            Minimum="{x:Static vm:LibraryViewModel.MinTileSize}" Maximum="{x:Static vm:LibraryViewModel.MaxTileSize}"
                            Value="{Binding TileSize}" SmallChange="8" LargeChange="32" AutomationProperties.Name="Thumbnail size" />
                    <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#5A6B78" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Preferences: the gear -->
                <Menu DockPanel.Dock="Right" Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Padding="9,6" ToolTip="Preferences" AutomationProperties.Name="Preferences">
                        <MenuItem.Header>
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#3A4A56" />
                        </MenuItem.Header>
                        <MenuItem Header="Manage folders…" Click="OnManageFolders" />
                        <MenuItem Header="Add folder…" Command="{Binding AddFolderCommand}" />
                        <MenuItem Header="Search inside archives (.zip, .7z, .rar)" IsCheckable="True" IsChecked="{Binding SearchInsideArchives}" />
                        <MenuItem Header="Thumbnail speed">
                            <MenuItem Header="Full speed (every core)" IsCheckable="True" IsChecked="{Binding SpeedFull}" />
                            <MenuItem Header="Balanced (half, lower priority)" IsCheckable="True" IsChecked="{Binding SpeedBalanced}" />
                            <MenuItem Header="In the background (one at a time, lowest priority)" IsCheckable="True" IsChecked="{Binding SpeedBackground}" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Open data folder" Command="{Binding OpenDataFolderCommand}" />
                        <MenuItem Header="Show log file" Command="{Binding ShowLogCommand}" />
                        <Separator />
                        <MenuItem Header="Check for updates automatically" IsCheckable="True" IsChecked="{Binding Updates.CheckAutomatically}" />
                        <MenuItem Header="Check for updates now" Command="{Binding Updates.CheckNowCommand}" />
                        <MenuItem Header="About Xandrite…" Command="{Binding Updates.AboutCommand}" />
                        <!-- Only when started with the developer switch: extra logging, all written to the normal log file -->
                        <Separator Visibility="{Binding DeveloperMode, Converter={StaticResource Visible}}" />
                        <MenuItem Header="Developer" Visibility="{Binding DeveloperMode, Converter={StaticResource Visible}}">
                            <MenuItem Header="Log archives opened and closed" IsCheckable="True" IsChecked="{Binding LogArchives}" />
                            <MenuItem Header="Log archive reads, seeks and writes (very detailed)" IsCheckable="True" IsChecked="{Binding LogArchiveIo}" />
                            <MenuItem Header="Log files opened and closed" IsCheckable="True" IsChecked="{Binding LogFiles}" />
                            <MenuItem Header="Log threads started and ended" IsCheckable="True" IsChecked="{Binding LogThreads}" />
                            <MenuItem Header="Thread id on every log line" IsCheckable="True" IsChecked="{Binding LogThreadIds}" />
                            <Separator />
                            <MenuItem Header="Show log file" Command="{Binding ShowLogCommand}" />
                        </MenuItem>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <!-- ===== Under the toolbar: the selection's actions, or the filters that are on (nothing when neither) ===== -->
        <Border DockPanel.Dock="Top" Background="#EAF1FC" BorderBrush="#C3D3EA" BorderThickness="0,0,0,1" Padding="14,7"
                Visibility="{Binding ShowSelectionBar, Converter={StaticResource Visible}}">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" Foreground="#1A4A91" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding DownloadSelectedCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Download…" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Margin="6,0,0,0" Click="OnOpenButtonMenu" AutomationProperties.Name="Rate the selection">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Rate" />
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="★★★★★" Command="{Binding RateSelectedCommand}" CommandParameter="5" />
                            <MenuItem Header="★★★★☆" Command="{Binding RateSelectedCommand}" CommandParameter="4" />
                            <MenuItem Header="★★★☆☆" Command="{Binding RateSelectedCommand}" CommandParameter="3" />
                            <MenuItem Header="★★☆☆☆" Command="{Binding RateSelectedCommand}" CommandParameter="2" />
                            <MenuItem Header="★☆☆☆☆" Command="{Binding RateSelectedCommand}" CommandParameter="1" />
                            <Separator />
                            <MenuItem Header="Unrated" Command="{Binding RateSelectedCommand}" CommandParameter="" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource ToolButton}" Margin="6,0,0,0" Command="{Binding CopySelectedPathsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Copy paths" />
                    </StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{Binding SelectAllText}" Style="{StaticResource LinkButton}" Command="{Binding SelectAllCommand}" />
                    <Button Content="Clear selection" Style="{StaticResource LinkButton}" Command="{Binding ClearSelectionCommand}" Margin="14,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="#F6F8F9" BorderBrush="#D5DBE0" BorderThickness="0,0,0,1" Padding="14,6"
                Visibility="{Binding ShowFilterChips, Converter={StaticResource Visible}}">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding MatchText}" Foreground="#5A6B78" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ItemsControl ItemsSource="{Binding ActiveFilters}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FilterChip}">
                            <Button Style="{StaticResource Chip}" Command="{Binding Remove}" Margin="0,2,6,2"
                                    ToolTip="{Binding RemoveLabel}" AutomationProperties.Name="{Binding RemoveLabel}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#5A6B78" VerticalAlignment="Center" Margin="8,1,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Clear all" Style="{StaticResource LinkButton}" Command="{Binding ClearAllFiltersCommand}" Margin="4,0,0,0" />
            </DockPanel>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D5DBE0" BorderThickness="0,1,0,0" Padding="10,5">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Restart to update" Padding="10,2" Margin="8,0,0,0" FontWeight="SemiBold"
                        Command="{Binding Updates.RestartCommand}"
                        Visibility="{Binding Updates.IsReady, Converter={StaticResource Visible}}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Updates.Text}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource Accent}" />
                <Button DockPanel.Dock="Right" Content="Rescan All" Padding="10,2" Margin="8,0,0,0" Command="{Binding RescanAllCommand}"
                        Visibility="{Binding HasRoots, Converter={StaticResource Visible}}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding ThumbnailText}" VerticalAlignment="Center" Foreground="#4A5A66" />
                    <Button Content="Pause" Padding="8,1" Margin="6,0,0,0" Command="{Binding PauseThumbnailsCommand}"
                            Visibility="{Binding CanPauseThumbnails, Converter={StaticResource Visible}}" />
                    <Button Content="Resume" Padding="8,1" Margin="6,0,0,0" Command="{Binding ResumeThumbnailsCommand}"
                            Visibility="{Binding CanResumeThumbnails, Converter={StaticResource Visible}}" />
                    <Button Content="Retry failed" Padding="8,1" Margin="6,0,0,0" Command="{Binding RetryFailedCommand}"
                            Visibility="{Binding HasFailedThumbnails, Converter={StaticResource Visible}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StatsText}" VerticalAlignment="Center" />
                    <TextBlock Text=" · " VerticalAlignment="Center" Visibility="{Binding CopiesText, Converter={StaticResource IfText}}" />
                    <Button Content="{Binding CopiesText}" Style="{StaticResource LinkButton}" FontSize="12" Command="{Binding ShowCopiesCommand}"
                            ToolTip="Show only the models found in more than one place"
                            Visibility="{Binding CopiesText, Converter={StaticResource IfText}}" />
                    <TextBlock Text="{Binding ListText}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#4A5A66" />
                    <TextBlock Text="{Binding ScanText}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#4A5A66" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                    <Button Content="Cancel" Padding="8,1" Margin="6,0,0,0" Command="{Binding CancelScanCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding ActivityText}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#4A5A66" />
                    <TextBlock Text="{Binding ImportText}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#4A5A66" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Main area ===== -->
        <Grid>
            <!-- Welcome: shown while the library has no folders. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                        Visibility="{Binding HasRoots, Converter={StaticResource Visible}, ConverterParameter=Invert}">
                <TextBlock Text="Welcome to Xandrite" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Every model has a side worth seeing." FontStyle="Italic" Foreground="#5A6B78" HorizontalAlignment="Center" Margin="0,4,0,18" />
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="#3A4A56" Margin="0,0,0,18"
                           Text="Add a folder of .stl and .3mf files. Xandrite finds every model in it, including those inside zip files, and draws a thumbnail of each. Your files are never changed." />
                <Button Content="Add folder…" Command="{Binding AddFolderCommand}" HorizontalAlignment="Center" Padding="18,6" FontSize="14" />
                <TextBlock Text="You can also drop folders on this window." Foreground="#7A8A96" HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>

            <Grid Visibility="{Binding HasRoots, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" MinWidth="150" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Folder tree, with whether a folder includes its subfolders right above it -->
                <DockPanel Grid.Column="0" Background="#F6F8F9">
                <DockPanel DockPanel.Dock="Top" Margin="12,10,10,4">
                    <CheckBox DockPanel.Dock="Right" Content="Subfolders" IsChecked="{Binding IncludeSubfolders}" FontSize="12" Foreground="#3A4A56"
                              ToolTip="Show the models in a folder's subfolders too" />
                    <TextBlock Text="FOLDERS" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <TreeView x:Name="FolderTree" ItemsSource="{Binding Folders}" BorderThickness="0" Background="#F6F8F9" Padding="4"
                          MouseRightButtonUp="OnFolderRightClick">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="2,2" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}" ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Label}" ToolTip="{Binding Path}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#D5DBE0" />

                <!-- Thumbnail grid: a virtualised list of rows, so only the rows on screen are built. -->
                <ItemsControl x:Name="TileGrid" Grid.Column="2" ItemsSource="{Binding Rows}" Focusable="True"
                              Padding="12,12,4,12" Background="#E7EBEE"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="True"
                              SizeChanged="OnGridSizeChanged"
                              MouseLeftButtonDown="OnGridBackgroundClick">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <Border Background="{TemplateBinding Background}">
                                <ScrollViewer x:Name="PART_Scroll" CanContentScroll="True" Focusable="False"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible"
                                              Padding="{TemplateBinding Padding}">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TileRowViewModel}">
                            <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}" Margin="0,0,0,8" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Column="2" Text="No files match." Foreground="#7A8A96" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding IsListEmpty, Converter={StaticResource Visible}}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
