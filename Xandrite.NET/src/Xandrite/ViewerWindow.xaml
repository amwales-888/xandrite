<Window x:Class="Xandrite.App.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Xandrite.App"
        Title="{Binding Title}"
        Width="1100" Height="780" MinWidth="700" MinHeight="460"
        Icon="Xandrite.ico"
        Background="#ECEFF2"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        KeyDown="OnKeyDown">

    <Window.Resources>
        <local:BoolToVisibility x:Key="Visible" />
        <local:EmptyToCollapsed x:Key="IfText" />
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#6B7A86" />
            <Setter Property="Margin" Value="0,3,10,3" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Value">
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D5DBE0" BorderThickness="0,1,0,0" Padding="10,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding AdapterText}" Foreground="#7A8A96" />
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Side panel -->
        <Border DockPanel.Dock="Right" Width="340" Background="White" BorderBrush="#D5DBE0" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,12">
                    <TextBlock TextWrapping="Wrap" Foreground="#3A4A56"
                               Text="Turn the model to the view that shows it best, then press Update to use that view as its thumbnail in your library." />
                    <TextBlock Margin="0,6,0,14" Foreground="#7A8A96" FontSize="11" TextWrapping="Wrap"
                               Text="Left-drag turns · right-drag (or Shift + left-drag) pans · the wheel zooms · R resets the view" />

                    <!-- File -->
                    <TextBlock Text="File" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Name" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding FileName}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Format" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding FormatText}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Size" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding SizeText}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Triangles" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding TrianglesText}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Dimensions" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding DimensionsText}" />
                        <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="SHA-256" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Sha256Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                 TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,3" />
                        <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Rating" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                            <ComboBox Width="120" ItemsSource="{Binding RatingChoices}" SelectedItem="{Binding Rating}" DisplayMemberPath="Label"
                                      IsEnabled="{Binding CanRate}" ToolTip="Open the model from the library to rate it." ToolTipService.ShowOnDisabled="True" />
                            <TextBlock Text="{Binding RatingNote}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#2E7D32" />
                        </StackPanel>
                    </Grid>

                    <!-- View -->
                    <TextBlock Text="View" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
                    <CheckBox Content="Z up (STL and 3MF files usually are)" IsChecked="{Binding ZUp}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Update thumbnail" Command="{Binding UpdateThumbnailCommand}" Padding="12,4" FontWeight="SemiBold" />
                        <Button Content="Reset view" Command="{Binding ResetViewCommand}" Padding="10,4" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateNote}" TextWrapping="Wrap" Foreground="#3A4A56"
                               Visibility="{Binding UpdateNote, Converter={StaticResource IfText}}" Margin="0,0,0,6" />
                    <Button Content="Revert to automatic view" Command="{Binding RevertCommand}" HorizontalAlignment="Left" Padding="10,2"
                            Visibility="{Binding HasCustomView, Converter={StaticResource Visible}}" Margin="0,0,0,6" />

                    <!-- Advanced -->
                    <Expander Header="Advanced" Margin="0,8,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PNG size" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Width="80" ItemsSource="{Binding ExportSizes}" SelectedItem="{Binding ExportSize}" />
                                <Button Content="Export as…" Command="{Binding SavePngCommand}" Padding="10,2" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="View settings stored in the PNG" Margin="0,10,0,4" Foreground="#6B7A86" />
                            <TextBox Text="{Binding ViewSettingsText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                     BorderThickness="0" Background="#F6F8F9" Padding="6" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- The 3D view -->
        <Border x:Name="Viewport" Background="#DFE5EA" ClipToBounds="True" Focusable="True"
                SizeChanged="OnViewportSizeChanged"
                MouseDown="OnViewportMouseDown" MouseMove="OnViewportMouseMove" MouseUp="OnViewportMouseUp"
                MouseWheel="OnViewportMouseWheel" LostMouseCapture="OnViewportLostCapture">
            <Grid>
                <Image x:Name="FrameImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <TextBlock Text="Double-click a thumbnail in the library, or drop an .stl or .3mf file here."
                           Foreground="#5A6B78" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding HasModel, Converter={StaticResource Visible}, ConverterParameter=Invert}" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
